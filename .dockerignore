# Build outputs - never copy host bin/obj into the image; force a clean restore/build inside Docker.
**/bin/
**/obj/

# Node modules - restored fresh inside the Docker build via `npm ci`.
**/node_modules/
**/dist/

# IDE / editor folders
**/.vs/
**/.idea/
**/.vscode/

# VCS
**/.git/
**/.gitignore
**/.gitattributes

# WPF/CLI front-ends are not part of the web image.
OnvifManager/bin/
OnvifManager/obj/
OnvifManager.Cli/bin/
OnvifManager.Cli/obj/

# Local persistent state mounted into the container at runtime.
deploy/data/

# Logs and misc
*.log
**/*.user
**/*.suo

# Docs / mockups not needed at build time
mockups/
README.md
LICENSE
CLAUDE.md
