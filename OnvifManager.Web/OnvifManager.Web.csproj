<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OnvifManager.Web</RootNamespace>
    <AssemblyName>OnvifManager.Web</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OnvifManager.Core\OnvifManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Vendors\Profiles\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Vendors\Profiles\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!--
    SPA build target is deferred until devops-docker / publish flow is wired.
    Frontend is built externally during M0; wwwroot is populated by the React agent.
  -->

</Project>
