<Window x:Class="OnvifManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OnvifManager.ViewModels"
        xmlns:views="clr-namespace:OnvifManager.Views"
        Title="ONVIF Camera Manager"
        Height="720" Width="1100"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DiscoveryViewModel}">
            <views:DiscoveryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceInfoViewModel}">
            <views:DeviceInfoView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VideoConfigViewModel}">
            <views:VideoConfigView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkConfigViewModel}">
            <views:NetworkConfigView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#FF2D2D30" BorderBrush="#FF3E3E42" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ONVIF Manager"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           Margin="16,20,16,20"/>

                <StackPanel Grid.Row="1" Margin="8,0">
                    <TextBlock Text="Camera Details" Foreground="#FF999999"
                               Margin="8,0,0,8" FontSize="11" FontWeight="Bold"/>

                    <Button Content="  Device Info"
                            Command="{Binding NavigateToDeviceInfoCommand}"
                            Margin="0,2" Padding="12,10"
                            Background="#FF3E3E42" Foreground="White"
                            BorderThickness="0" FontSize="14"
                            HorizontalContentAlignment="Left" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="  Video Config"
                            Command="{Binding NavigateToVideoConfigCommand}"
                            Margin="0,2" Padding="12,10"
                            Background="#FF3E3E42" Foreground="White"
                            BorderThickness="0" FontSize="14"
                            HorizontalContentAlignment="Left" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="  Network Config"
                            Command="{Binding NavigateToNetworkConfigCommand}"
                            Margin="0,2" Padding="12,10"
                            Background="#FF3E3E42" Foreground="White"
                            BorderThickness="0" FontSize="14"
                            HorizontalContentAlignment="Left" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" Background="#FF1E1E1E" Padding="12,10">
                    <TextBlock Text="{Binding Discovery.StatusText}"
                               Foreground="#FFAAAAAA" FontSize="11"
                               TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>

        <!-- Right panel: split vertically -->
        <Grid Grid.Column="1" Background="#FF1E1E1E">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="150"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="150"/>
            </Grid.RowDefinitions>

            <!-- Top: Camera discovery and list -->
            <ContentControl Grid.Row="0" Content="{Binding Discovery}"/>

            <!-- Splitter -->
            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                          Background="#FF555555" Cursor="SizeNS"/>

            <!-- Bottom: Camera parameters -->
            <ContentControl Grid.Row="2" Content="{Binding BottomViewModel}"/>
        </Grid>
    </Grid>
</Window>
