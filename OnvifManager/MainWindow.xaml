<Window x:Class="OnvifManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OnvifManager.ViewModels"
        xmlns:views="clr-namespace:OnvifManager.Views"
        Title="ONVIF Camera Manager"
        Background="{StaticResource BgBase}"
        Height="720" Width="1100"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DiscoveryViewModel}">
            <views:DiscoveryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceInfoViewModel}">
            <views:DeviceInfoView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VideoConfigViewModel}">
            <views:VideoConfigView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkConfigViewModel}">
            <views:NetworkConfigView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ONVIF Manager"
                           Style="{StaticResource H2}"
                           Margin="16,20,16,20"/>

                <StackPanel Grid.Row="1" Margin="8,0">
                    <TextBlock Text="CAMERA DETAILS" Style="{StaticResource Muted}"
                               Margin="8,0,0,8" FontSize="11" FontWeight="Bold"/>

                    <Button Content="Device Info"
                            Command="{Binding NavigateToDeviceInfoCommand}"
                            Style="{StaticResource NavButton}"/>

                    <Button Content="Video Config"
                            Command="{Binding NavigateToVideoConfigCommand}"
                            Style="{StaticResource NavButton}"/>

                    <Button Content="Network Config"
                            Command="{Binding NavigateToNetworkConfigCommand}"
                            Style="{StaticResource NavButton}"/>
                </StackPanel>

                <Border Grid.Row="2" Background="{StaticResource BgBase}" Padding="12,10">
                    <TextBlock Text="{Binding Discovery.StatusText}"
                               Style="{StaticResource Muted}"
                               FontSize="11" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>

        <!-- Right panel: split vertically -->
        <Grid Grid.Column="1" Background="{StaticResource BgBase}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="150"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="150"/>
            </Grid.RowDefinitions>

            <ContentControl Grid.Row="0" Content="{Binding Discovery}"/>

            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                          Cursor="SizeNS"/>

            <ContentControl Grid.Row="2" Content="{Binding BottomViewModel}"/>
        </Grid>
    </Grid>
</Window>
