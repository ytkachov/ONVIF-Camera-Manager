<Window x:Class="OnvifManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OnvifManager.ViewModels"
        xmlns:views="clr-namespace:OnvifManager.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:r="clr-namespace:OnvifManager.Resources"
        Title="SeaGull"
        Background="{StaticResource BgSurface}"
        Height="760" Width="1240"
        MinHeight="560" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/seagull.ico"
        WindowStyle="None"
        ResizeMode="CanResize">

    <Window.InputBindings>
        <KeyBinding Key="F11" Command="{Binding ToggleFullscreenCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding ExitFullscreenCommand}"/>
    </Window.InputBindings>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title strip (drag region + menu + window buttons) -->
            <Border Grid.Row="0" Background="{StaticResource BgPanelHeader}"
                    BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo + app name -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,12,0"
                                VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/seagull-20.png" Width="18" Height="18"
                               shell:WindowChrome.IsHitTestVisibleInChrome="False"/>
                        <TextBlock Text="{x:Static r:Strings.AppName}"
                                   Margin="8,0,0,0"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Menu -->
                    <Menu Grid.Column="1" Background="Transparent"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True"
                          VerticalAlignment="Center">
                        <MenuItem Header="_Файл">
                            <MenuItem Header="Очистить список камер…"
                                      Command="{Binding ClearCameraListCommand}"/>
                            <Separator/>
                            <MenuItem Header="Выход" Click="Exit_Click"/>
                        </MenuItem>
                        <MenuItem Header="_Вид"/>
                        <MenuItem Header="_Камеры">
                            <MenuItem Header="Поиск" Command="{Binding ScanCommand}"/>
                            <MenuItem Header="Добавить вручную…" Command="{Binding AddManualCommand}"/>
                            <Separator/>
                            <MenuItem Header="Перезагрузить камеру…"
                                      Command="{Binding RebootCameraCommand}"/>
                        </MenuItem>
                        <MenuItem Header="_Запись"/>
                        <MenuItem Header="_Инструменты">
                            <MenuItem Header="Журнал…" Click="OpenLog_Click"/>
                        </MenuItem>
                        <MenuItem Header="_Справка"/>
                    </Menu>

                    <!-- Drag spacer -->
                    <Grid Grid.Column="2" Background="Transparent"/>

                    <!-- Window control buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitlebarButton}"
                                Click="Minimize_Click"
                                ToolTip="Свернуть">
                            <Path Data="M 0 5 L 10 5" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1" Width="10" Height="10" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource TitlebarButton}"
                                Click="MaxRestore_Click"
                                x:Name="MaxRestoreBtn"
                                ToolTip="Развернуть">
                            <Path x:Name="MaxRestoreGlyph"
                                  Data="M 0 0 L 10 0 L 10 10 L 0 10 Z"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1" Width="10" Height="10" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource TitlebarCloseButton}"
                                Click="Close_Click"
                                ToolTip="Закрыть">
                            <Path Data="M 0 0 L 10 10 M 10 0 L 0 10"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1" Width="10" Height="10" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Toolbar -->
            <Border Grid.Row="1" Background="{StaticResource BgElevated}"
                    BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource PrimaryToolbarButton}"
                            Command="{Binding ScanCommand}"
                            IsEnabled="{Binding Discovery.IsScanning, Converter={StaticResource InverseBool}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Fill="White"
                                  Data="{StaticResource IconSearch}" Stretch="Uniform"/>
                            <TextBlock Text="Поиск камер" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Style="{StaticResource ToolbarButton}"
                            Command="{Binding AddManualCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Fill="{StaticResource TextSecondary}"
                                  Data="{StaticResource IconPlus}" Stretch="Uniform"/>
                            <TextBlock Text="Добавить вручную" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="2" Width="1" Height="22"
                            Background="{StaticResource BorderStrong}" Margin="4,0,10,0"/>

                    <Button Grid.Column="3" Style="{StaticResource ToolbarButton}"
                            Command="{Binding StartStreamCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="13" Fill="{StaticResource TextSecondary}"
                                  Data="{StaticResource IconPlay}" Stretch="Uniform"/>
                            <TextBlock Text="Старт" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" Style="{StaticResource ToolbarButton}"
                            Command="{Binding StopStreamCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="11" Height="11" Fill="{StaticResource TextSecondary}"
                                  Data="{StaticResource IconStop}" Stretch="Uniform"/>
                            <TextBlock Text="Стоп" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="5" Style="{StaticResource ToolbarButton}"
                            Command="{Binding ToggleRecordCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="11" Height="11" Fill="{StaticResource Danger}"/>
                            <TextBlock Text="Запись" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="6" Style="{StaticResource ToolbarButton}"
                            Command="{Binding SnapshotCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Fill="{StaticResource TextSecondary}"
                                  Data="{StaticResource IconSnapshot}" Stretch="Uniform"/>
                            <TextBlock Text="Снимок" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="7" Width="1" Height="22"
                            Background="{StaticResource BorderStrong}" Margin="4,0,10,0"/>

                    <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource ToolbarButton}"
                                Click="OpenLog_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Fill="{StaticResource TextSecondary}"
                                      Data="{StaticResource IconLog}" Stretch="Uniform"/>
                                <TextBlock Text="Журнал" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}"
                                Margin="6,0,0,0"
                                Command="{Binding OpenSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Fill="{StaticResource TextSecondary}"
                                      Data="{StaticResource IconSettings}" Stretch="Uniform"/>
                                <TextBlock Text="Настройки" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="9" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8"
                                 VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Success}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Discovery.IsScanning}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource AccentLight}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Discovery.SelectedNetworkInterface.IpAddress, StringFormat='Сеть: {0}', TargetNullValue='Сеть: —'}"
                                   Foreground="{StaticResource TextMuted}" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main: 3-column layout with splitter -->
            <Grid Grid.Row="2" Background="{StaticResource BgBase}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="360" MinWidth="280" MaxWidth="640"/>
                </Grid.ColumnDefinitions>

                <views:CameraListView Grid.Column="0" DataContext="{Binding Discovery}">
                    <views:CameraListView.Style>
                        <Style TargetType="views:CameraListView">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsFullscreen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:CameraListView.Style>
                </views:CameraListView>

                <views:VideoView Grid.Column="1">
                    <views:VideoView.Style>
                        <Style TargetType="views:VideoView">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                    <Setter Property="Grid.Column" Value="0"/>
                                    <Setter Property="Grid.ColumnSpan" Value="4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:VideoView.Style>
                </views:VideoView>

                <GridSplitter Grid.Column="2" Width="4"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="{StaticResource Divider}"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="False">
                    <GridSplitter.Style>
                        <Style TargetType="GridSplitter">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </GridSplitter.Style>
                </GridSplitter>

                <Grid Grid.Column="3" Background="{StaticResource BgPanel}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Parameter set switch: ONVIF spec only vs all vendor params -->
                    <Border Grid.Row="0" Background="{StaticResource BgPanelHeader}"
                            BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Параметры:" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,12,0"/>
                            <TextBlock Text="ONVIF" VerticalAlignment="Center" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFullMode}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="8,0,8,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsFullMode, Mode=TwoWay}"
                                      ToolTip="ONVIF — только параметры спецификации. Полный — все параметры известной (vendor) камеры."/>
                            <TextBlock Text="Полный" VerticalAlignment="Center" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFullMode}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                          Data="{StaticResource IconInfo}"/>
                                    <TextBlock Text="Инфо" Margin="0,3,0,0"/>
                                </StackPanel>
                            </TabItem.Header>
                            <views:DeviceInfoView DataContext="{Binding DeviceInfo}"/>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                          Data="{StaticResource IconVideo}"/>
                                    <TextBlock Text="Видео" Margin="0,3,0,0"/>
                                </StackPanel>
                            </TabItem.Header>
                            <views:VideoConfigView DataContext="{Binding VideoConfig}"/>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                          Data="{StaticResource IconNetwork}"/>
                                    <TextBlock Text="Сеть" Margin="0,3,0,0"/>
                                </StackPanel>
                            </TabItem.Header>
                            <views:NetworkConfigView DataContext="{Binding NetworkConfig}"/>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                          Data="{StaticResource IconPtz}"/>
                                    <TextBlock Text="PTZ" Margin="0,3,0,0"/>
                                </StackPanel>
                            </TabItem.Header>
                            <views:PtzView DataContext="{Binding Ptz}"/>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                          Data="{StaticResource IconEvents}"/>
                                    <TextBlock Text="События" Margin="0,3,0,0"/>
                                </StackPanel>
                            </TabItem.Header>
                            <views:EventsView DataContext="{Binding Events}"/>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="2" Background="{StaticResource BgPanelHeader}"
                            BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                            Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Отмена"
                                    Command="{Binding CancelActiveCommand}"
                                    Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Content="Применить"
                                    Style="{StaticResource AccentButton}"
                                    Command="{Binding ApplyActiveCommand}"
                                    Margin="4,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="3" Background="{StaticResource Accent}" Padding="14,5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="White" FontSize="11"/>
                    <TextBlock Grid.Column="1" Text="|" Foreground="#80FFFFFF" Margin="14,0" FontSize="11"/>
                    <TextBlock Grid.Column="2" Foreground="White" FontSize="11">
                        <Run Text="Активная:"/>
                        <Run Text="{Binding Discovery.SelectedCamera.Name, FallbackValue='—'}"/>
                    </TextBlock>
                    <TextBlock Grid.Column="3" Text="|" Foreground="#80FFFFFF" Margin="14,0" FontSize="11"/>
                    <TextBlock Grid.Column="4" Foreground="White" FontSize="11">
                        <Run Text="Найдено:"/>
                        <Run Text="{Binding Discovery.Cameras.Count, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Grid.Column="5" Foreground="White" FontSize="11"
                               Margin="14,0,14,0" TextTrimming="CharacterEllipsis"
                               Text="{Binding Discovery.StatusText, Mode=OneWay}"
                               ToolTip="{Binding Discovery.StatusText}"
                               Cursor="Hand" MouseLeftButtonUp="OpenLog_Click"/>
                    <TextBlock Grid.Column="6" Foreground="White" FontSize="11">
                        <Run Text="{Binding ProfileText, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
