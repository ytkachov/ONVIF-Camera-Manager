<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===== Palette (matches HTML mockup) ===== -->
    <Color x:Key="BgBaseColor">#FF14161B</Color>
    <Color x:Key="BgSurfaceColor">#FF1E2128</Color>
    <Color x:Key="BgPanelColor">#FF20232A</Color>
    <Color x:Key="BgPanelHeaderColor">#FF1C1F25</Color>
    <Color x:Key="BgElevatedColor">#FF262A32</Color>
    <Color x:Key="BgInputColor">#FF15171C</Color>
    <Color x:Key="BgInputHoverColor">#FF2D3139</Color>
    <Color x:Key="BgControlColor">#FF353A44</Color>
    <Color x:Key="BgControlHoverColor">#FF404652</Color>
    <Color x:Key="BorderColor">#FF2D3139</Color>
    <Color x:Key="BorderStrongColor">#FF404652</Color>
    <Color x:Key="DividerColor">#FF15171C</Color>

    <Color x:Key="AccentColor">#FF2563EB</Color>
    <Color x:Key="AccentHoverColor">#FF3070EF</Color>
    <Color x:Key="AccentPressedColor">#FF1D4ED8</Color>
    <Color x:Key="AccentLightColor">#FF4A9EFF</Color>

    <Color x:Key="SuccessColor">#FF61C554</Color>
    <Color x:Key="WarnColor">#FFF4BD4F</Color>
    <Color x:Key="DangerColor">#FFE0584A</Color>
    <Color x:Key="DangerDeepColor">#FFC0392B</Color>
    <Color x:Key="OfflineColor">#FF6C727F</Color>

    <Color x:Key="TextPrimaryColor">#FFE6E9EF</Color>
    <Color x:Key="TextSecondaryColor">#FFC0C5CF</Color>
    <Color x:Key="TextMutedColor">#FF8B919C</Color>
    <Color x:Key="TextDimColor">#FF6C727F</Color>
    <Color x:Key="LinkColor">#FF4A9EFF</Color>

    <SolidColorBrush x:Key="BgBase" Color="{StaticResource BgBaseColor}"/>
    <SolidColorBrush x:Key="BgSurface" Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="BgPanel" Color="{StaticResource BgPanelColor}"/>
    <SolidColorBrush x:Key="BgPanelHeader" Color="{StaticResource BgPanelHeaderColor}"/>
    <SolidColorBrush x:Key="BgElevated" Color="{StaticResource BgElevatedColor}"/>
    <SolidColorBrush x:Key="BgInput" Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="BgInputHover" Color="{StaticResource BgInputHoverColor}"/>
    <SolidColorBrush x:Key="BgControl" Color="{StaticResource BgControlColor}"/>
    <SolidColorBrush x:Key="BgControlHover" Color="{StaticResource BgControlHoverColor}"/>
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="Divider" Color="{StaticResource DividerColor}"/>

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentLight" Color="{StaticResource AccentLightColor}"/>

    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerDeep" Color="{StaticResource DangerDeepColor}"/>
    <SolidColorBrush x:Key="Offline" Color="{StaticResource OfflineColor}"/>

    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextDim" Color="{StaticResource TextDimColor}"/>
    <SolidColorBrush x:Key="Link" Color="{StaticResource LinkColor}"/>

