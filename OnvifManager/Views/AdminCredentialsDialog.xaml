<Window x:Class="OnvifManager.Views.AdminCredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Учётная запись веб-админки"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{StaticResource BgSurface}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BgPanelHeader}"
                    BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Учётная запись веб-админки"
                               Foreground="{StaticResource TextPrimary}"
                               FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitlebarCloseButton}"
                                Click="Cancel_Click" ToolTip="Закрыть">
                            <Path Data="M 0 0 L 10 10 M 10 0 L 0 10"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1" Width="10" Height="10" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,16,18,18">
                <TextBlock TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondary}" FontSize="12"
                           Margin="0,0,0,16">
                    Полный набор параметров читается через vendor-канал (ISAPI). У некоторых
                    устройств (например, NVR Hikvision) ONVIF-пользователь не имеет к нему доступа,
                    поэтому укажите учётную запись веб-админки камеры. Данные сохраняются для этой
                    камеры в зашифрованном виде. Оставьте поля пустыми, чтобы использовать
                    ONVIF-пользователя.
                </TextBlock>

                <TextBlock Text="Пользователь" Foreground="{StaticResource TextSecondary}"
                           FontSize="11" Margin="0,0,0,6"/>
                <TextBox x:Name="UserBox" Margin="0,0,0,14"/>

                <TextBlock Text="Пароль" Foreground="{StaticResource TextSecondary}"
                           FontSize="11" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PwdBox"/>

                <TextBlock x:Name="ErrorText"
                           Foreground="{StaticResource Danger}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{StaticResource BgPanelHeader}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="Пропустить"
                            Click="Cancel_Click" IsCancel="True"
                            Padding="16,7" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Сохранить"
                            Style="{StaticResource AccentButton}"
                            Padding="16,7" IsDefault="True"
                            Click="Save_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
