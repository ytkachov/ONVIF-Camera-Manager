<UserControl x:Class="OnvifManager.Views.Controls.IpAddressBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="28" d:DesignWidth="180">

    <UserControl.Resources>
        <Style x:Key="OctetBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MaxLength" Value="3"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        </Style>
        <Style x:Key="DotLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="2,0,2,2"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="Oct1" Grid.Column="0" Style="{StaticResource OctetBox}"
                 TextChanged="Oct_TextChanged" PreviewTextInput="Oct_PreviewTextInput"
                 PreviewKeyDown="Oct_PreviewKeyDown"/>
        <TextBlock Grid.Column="1" Text="." Style="{StaticResource DotLabel}"/>
        <TextBox x:Name="Oct2" Grid.Column="2" Style="{StaticResource OctetBox}"
                 TextChanged="Oct_TextChanged" PreviewTextInput="Oct_PreviewTextInput"
                 PreviewKeyDown="Oct_PreviewKeyDown"/>
        <TextBlock Grid.Column="3" Text="." Style="{StaticResource DotLabel}"/>
        <TextBox x:Name="Oct3" Grid.Column="4" Style="{StaticResource OctetBox}"
                 TextChanged="Oct_TextChanged" PreviewTextInput="Oct_PreviewTextInput"
                 PreviewKeyDown="Oct_PreviewKeyDown"/>
        <TextBlock Grid.Column="5" Text="." Style="{StaticResource DotLabel}"/>
        <TextBox x:Name="Oct4" Grid.Column="6" Style="{StaticResource OctetBox}"
                 TextChanged="Oct_TextChanged" PreviewTextInput="Oct_PreviewTextInput"
                 PreviewKeyDown="Oct_PreviewKeyDown"/>
    </Grid>
</UserControl>
