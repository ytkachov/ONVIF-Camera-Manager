<UserControl x:Class="OnvifManager.Views.DeviceInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="340">

    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="{StaticResource BgPanel}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Загрузка…" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14"
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <StackPanel>

                <!-- Identification -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="ИДЕНТИФИКАЦИЯ" Style="{StaticResource SectionTitle}"/>
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Имя" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Производитель" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding Manufacturer}" IsReadOnly="True"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Модель" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding Model}" IsReadOnly="True"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Прошивка" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding FirmwareVersion}" IsReadOnly="True"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Серийный №" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding SerialNumber}" IsReadOnly="True"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hardware ID" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding HardwareId}" IsReadOnly="True"/>
                    </Grid>
                </StackPanel>

                <!-- ONVIF -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="ONVIF" Style="{StaticResource SectionTitle}"/>
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Сервис URL" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding Endpoint}" IsReadOnly="True"
                                 TextWrapping="NoWrap"/>
                    </Grid>
                </StackPanel>

                <!-- Время -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="ВРЕМЯ" Style="{StaticResource SectionTitle}"/>
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Часовой пояс" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding TimeZone}" IsReadOnly="True"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Время (UTC)" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding CameraTimeUtc}" IsReadOnly="True"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Локальное" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding CameraTimeLocal}" IsReadOnly="True"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Источник" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding TimeSyncSource}" IsReadOnly="True"/>
                    </Grid>
                </StackPanel>

                <!-- Profiles -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="МЕДИА-ПРОФИЛИ" Style="{StaticResource SectionTitle}"/>
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgElevated}" CornerRadius="4"
                                        Padding="10,6" Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock FontSize="10"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontFamily="Consolas">
                                            <Run Text="Token: "/>
                                            <Run Text="{Binding Token}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Services -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="ONVIF-СЕРВИСЫ" Style="{StaticResource SectionTitle}"/>
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding Services}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgElevated}" CornerRadius="4"
                                        Padding="10,6" Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Uri}"
                                                   Foreground="{StaticResource Link}"
                                                   FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Namespace}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource Muted}" FontSize="11"
                           Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
