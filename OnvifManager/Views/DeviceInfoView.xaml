<UserControl x:Class="OnvifManager.Views.DeviceInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="340">

    <UserControl.Resources>
        <Style x:Key="ParamLabel" TargetType="TextBlock" BasedOn="{StaticResource FormLabel}">
            <Setter Property="Width" Value="115"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="{StaticResource BgPanel}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Загрузка…" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14"
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <StackPanel>

                <!-- Identification -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="ИДЕНТИФИКАЦИЯ" Style="{StaticResource SectionTitle}"/>
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Имя" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding Name}" IsReadOnly="True" Width="195"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Производитель" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding Manufacturer}" IsReadOnly="True" Width="195"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Модель" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding Model}" IsReadOnly="True" Width="195"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Прошивка" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding FirmwareVersion}" IsReadOnly="True" Width="195"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Серийный №" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding SerialNumber}" IsReadOnly="True" Width="195"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Hardware ID" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding HardwareId}" IsReadOnly="True" Width="195"/>
                    </StackPanel>
                </StackPanel>

                <!-- ONVIF -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="ONVIF" Style="{StaticResource SectionTitle}"/>
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Сервис URL" Style="{StaticResource ParamLabel}"/>
                        <TextBox Text="{Binding Endpoint}" IsReadOnly="True" Width="195"
                                 TextWrapping="NoWrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- Profiles -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="МЕДИА-ПРОФИЛИ" Style="{StaticResource SectionTitle}"/>
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgElevated}" CornerRadius="4"
                                        Padding="10,6" Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock FontSize="10"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontFamily="Consolas">
                                            <Run Text="Token: "/>
                                            <Run Text="{Binding Token}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Services -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="ONVIF-СЕРВИСЫ" Style="{StaticResource SectionTitle}"/>
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding Services}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgElevated}" CornerRadius="4"
                                        Padding="10,6" Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Uri}"
                                                   Foreground="{StaticResource Link}"
                                                   FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Namespace}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource Muted}" FontSize="11"
                           Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
