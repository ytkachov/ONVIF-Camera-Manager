<Window x:Class="OnvifManager.Views.ManualAddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:OnvifManager.Helpers"
        xmlns:c="clr-namespace:OnvifManager.Views.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Добавить камеру вручную"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{StaticResource BgSurface}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ParamLabel" TargetType="TextBlock" BasedOn="{StaticResource FormLabel}">
            <Setter Property="Width" Value="110"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom title strip with drag + close -->
            <Border Grid.Row="0" Background="{StaticResource BgPanelHeader}"
                    BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Добавить камеру вручную"
                               Foreground="{StaticResource TextPrimary}"
                               FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitlebarCloseButton}"
                                Click="Cancel_Click" ToolTip="Закрыть">
                            <Path Data="M 0 0 L 10 10 M 10 0 L 0 10"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1" Width="10" Height="10" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Section title -->
            <Border Grid.Row="1" Padding="18,14,18,0">
                <TextBlock Text="ПОДКЛЮЧЕНИЕ" Style="{StaticResource SectionTitle}"/>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="2" Margin="18,8,18,18">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="IP : порт" Style="{StaticResource FormLabel}"/>
                    <c:IpAddressBox Grid.Column="1"
                                    Address="{Binding ManualIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="IP-адрес камеры"/>
                    <TextBox Grid.Column="3"
                             Text="{Binding ManualPort, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Порт"/>
                </Grid>

                <TextBlock Text="например 192.168.1.64 · 80"
                           FontSize="11" FontFamily="{StaticResource MonoFont}"
                           Foreground="{StaticResource TextDim}"
                           Margin="110,0,0,12"/>

                <TextBlock Text="АВТОРИЗАЦИЯ" Style="{StaticResource SectionTitle}" Margin="0,4,0,8"/>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Пользователь" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding ManualUsername, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Пароль" Style="{StaticResource FormLabel}"/>
                    <PasswordBox Grid.Column="1" x:Name="PwdBox"
                                 helpers:PasswordBoxHelper.BindPassword="True"
                                 helpers:PasswordBoxHelper.BoundPassword="{Binding ManualPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ElementName=ShowPwd, Path=IsChecked, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                    <TextBox Grid.Column="1" x:Name="PwdText"
                             Text="{Binding ManualPassword, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding ElementName=ShowPwd, Path=IsChecked, Converter={StaticResource BoolToVis}}"/>
                    <ToggleButton Grid.Column="2" x:Name="ShowPwd"
                                  Style="{StaticResource IconToggleButton}"
                                  Margin="6,0,0,0"
                                  ToolTip="Показать пароль">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5C21.27 7.61 17 4.5 12 4.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"/>
                    </ToggleButton>
                </Grid>
            </StackPanel>

            <!-- Error banner -->
            <Border Grid.Row="3" Background="#22E0584A"
                    BorderBrush="{StaticResource Danger}" BorderThickness="0,1,0,1"
                    Padding="18,10"
                    Visibility="{Binding LastProbeError, Converter={StaticResource StringToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Fill="{StaticResource Danger}" VerticalAlignment="Center"
                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                    <TextBlock Text="{Binding LastProbeError}"
                               Foreground="{StaticResource Danger}"
                               FontSize="12" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="4" Background="{StaticResource BgPanelHeader}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsProbing, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Width="80" Height="3"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="Проверка…" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="Отмена"
                            Click="Cancel_Click"
                            IsCancel="True"
                            Padding="16,7" Margin="0,0,8,0"/>
                    <Button Grid.Column="3" Content="Добавить"
                            Style="{StaticResource AccentButton}"
                            Padding="16,7"
                            IsDefault="True"
                            IsEnabled="{Binding IsProbing, Converter={StaticResource InverseBool}}"
                            Click="Add_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
