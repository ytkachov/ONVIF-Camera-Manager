<UserControl x:Class="OnvifManager.Views.NetworkConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="340">

    <UserControl.Resources>
        <Style x:Key="ParamLabel" TargetType="TextBlock" BasedOn="{StaticResource FormLabel}">
            <Setter Property="Width" Value="115"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
        <StackPanel>

            <!-- Interface -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="ИНТЕРФЕЙС" Style="{StaticResource SectionTitle}"/>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Интерфейс" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Interfaces}"
                              SelectedItem="{Binding SelectedInterface}"
                              DisplayMemberPath="Display"
                              ToolTip="Сетевой интерфейс камеры (обычно один — eth0)."/>
                </Grid>
            </StackPanel>

            <!-- IPv4 -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="IPv4" Style="{StaticResource SectionTitle}"/>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Активен" Style="{StaticResource ParamLabel}"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="DHCP" Style="{StaticResource ParamLabel}"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IPv4Dhcp}"/>
                </StackPanel>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="IP-адрес" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding IPv4Address}"
                             IsEnabled="{Binding IPv4Dhcp, Converter={StaticResource InverseBool}}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Префикс" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding IPv4PrefixLength}"
                             IsEnabled="{Binding IPv4Dhcp, Converter={StaticResource InverseBool}}"
                             ToolTip="Длина маски подсети в битах: 24 = 255.255.255.0, 16 = 255.255.0.0. Доступно только при выключенном DHCP."/>
                </Grid>
            </StackPanel>

            <!-- Hardware -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="HARDWARE" Style="{StaticResource SectionTitle}"/>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MAC" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding HwAddress}" IsReadOnly="True"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MTU" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding Mtu}"
                             ToolTip="Maximum Transmission Unit — макс. размер сетевого кадра в байтах. Стандарт для Ethernet — 1500."/>
                </Grid>
            </StackPanel>

            <!-- DNS -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="DNS" Style="{StaticResource SectionTitle}"/>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Width="115" Text="Из DHCP" Style="{StaticResource FormLabel}"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DnsFromDhcp}"
                              IsEnabled="False"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding DnsServers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgElevated}" CornerRadius="4"
                                    Padding="10,5" Margin="0,0,0,4">
                                <TextBlock Text="{Binding}"
                                           Foreground="{StaticResource Link}"
                                           FontSize="11" FontFamily="Consolas"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- NTP -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="NTP" Style="{StaticResource SectionTitle}"/>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Width="115" Text="Из DHCP" Style="{StaticResource FormLabel}"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NtpFromDhcp}"
                              IsEnabled="False"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding NtpServers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgElevated}" CornerRadius="4"
                                    Padding="10,5" Margin="0,0,0,4">
                                <TextBlock Text="{Binding}"
                                           Foreground="{StaticResource Link}"
                                           FontSize="11" FontFamily="Consolas"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource Muted}" FontSize="11"
                       Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
