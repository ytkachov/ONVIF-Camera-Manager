<Window x:Class="OnvifManager.Views.SearchCamerasDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:OnvifManager.Helpers"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Поиск камер"
        Width="760" Height="580"
        MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{StaticResource BgSurface}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title strip -->
            <Border Grid.Row="0" Background="{StaticResource BgPanelHeader}"
                    BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Поиск камер в сети"
                               Foreground="{StaticResource TextPrimary}"
                               FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitlebarCloseButton}"
                                Click="Cancel_Click" ToolTip="Закрыть">
                            <Path Data="M 0 0 L 10 10 M 10 0 L 0 10"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1" Width="10" Height="10" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Search controls -->
            <Border Grid.Row="1" Padding="18,14,18,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Интерфейс" Style="{StaticResource FormLabel}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Margin="8,0,12,0"
                              ItemsSource="{Binding NetworkInterfaces}"
                              SelectedItem="{Binding SelectedNetworkInterface}"
                              DisplayMemberPath="DisplayText"
                              IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"/>
                    <Button Grid.Column="2" Content="Поиск"
                            Style="{StaticResource AccentButton}"
                            Padding="20,7"
                            Command="{Binding ScanCommand}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"/>
                </Grid>
            </Border>

            <!-- Progress -->
            <Border Grid.Row="2" Padding="18,0,18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Height="4" Maximum="100"
                                 Value="{Binding ScanProgress}"
                                 Background="{StaticResource BgInput}" BorderThickness="0"
                                 Foreground="{StaticResource Accent}"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0"
                               Text="{Binding FoundCount, StringFormat='Найдено: {0}'}"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Results table -->
            <DataGrid Grid.Row="3" Margin="18,0,18,0"
                      ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedRow}"
                      SelectionMode="Single"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="34">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="9" Height="9"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="{Binding Device.Status, Converter={StaticResource CameraStatusBrush}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Имя" Width="*"
                                        Binding="{Binding Device.Name}"/>
                    <DataGridTextColumn Header="Адрес" Width="120"
                                        Binding="{Binding Device.IpAddress}"
                                        FontFamily="{StaticResource MonoFont}"/>
                    <DataGridTextColumn Header="Порт" Width="60"
                                        Binding="{Binding Device.Port}"
                                        FontFamily="{StaticResource MonoFont}"/>
                    <DataGridTextColumn Header="Производитель" Width="130"
                                        Binding="{Binding Device.Manufacturer}"/>
                    <DataGridTextColumn Header="Статус" Width="110"
                                        Binding="{Binding Device.Protocol}"/>
                    <DataGridTemplateColumn Header="В списке" Width="64">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Path Width="13" Height="13" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{StaticResource Accent}"
                                      Data="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                      Visibility="{Binding IsAdded, Converter={StaticResource BoolToVis}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Credentials + test for the selected row -->
            <Border Grid.Row="4" Padding="18,12,18,8">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRow}" Value="{x:Null}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Пользователь" Style="{StaticResource FormLabel}"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Margin="8,0,16,0"
                             Text="{Binding SelectedRow.Device.Username, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Column="2" Text="Пароль" Style="{StaticResource FormLabel}"
                               VerticalAlignment="Center"/>
                    <Grid Grid.Column="3" Margin="8,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PwdBox"
                                     helpers:PasswordBoxHelper.BindPassword="True"
                                     helpers:PasswordBoxHelper.BoundPassword="{Binding SelectedRow.Device.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding ElementName=ShowPwd, Path=IsChecked, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        <TextBox Text="{Binding SelectedRow.Device.Password, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ElementName=ShowPwd, Path=IsChecked, Converter={StaticResource BoolToVis}}"/>
                        <ToggleButton Grid.Column="1" x:Name="ShowPwd"
                                      Style="{StaticResource IconToggleButton}"
                                      Margin="6,0,0,0" ToolTip="Показать пароль">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5C21.27 7.61 17 4.5 12 4.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"/>
                        </ToggleButton>
                    </Grid>

                    <Button Grid.Column="6" Content="Проверить"
                            Padding="16,7"
                            Command="{Binding TestSelectedCommand}"/>
                </Grid>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="5" Background="{StaticResource BgPanelHeader}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText}"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0"/>

                    <Button Grid.Column="1" Content="Добавить все"
                            Padding="16,7" Margin="0,0,8,0"
                            Command="{Binding AddAllCommand}"/>
                    <Button Grid.Column="2" Content="Добавить"
                            Style="{StaticResource AccentButton}"
                            Padding="16,7" Margin="0,0,8,0"
                            Command="{Binding AddSelectedCommand}"/>
                    <Button Grid.Column="3" Content="Закрыть"
                            Padding="16,7"
                            IsCancel="True"
                            Click="Cancel_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
