<Window x:Class="OnvifManager.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Настройки"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{StaticResource BgSurface}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BgPanelHeader}"
                    BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Настройки"
                               Foreground="{StaticResource TextPrimary}"
                               FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitlebarCloseButton}"
                                Click="Cancel_Click" ToolTip="Закрыть">
                            <Path Data="M 0 0 L 10 10 M 10 0 L 0 10"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1" Width="10" Height="10" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="18,14,18,0">
                <TextBlock Text="ВИДЕО" Style="{StaticResource SectionTitle}"/>
            </Border>

            <StackPanel Grid.Row="2" Margin="18,8,18,18">
                <CheckBox x:Name="AutoPlayChk"
                          Content="Автоматически запускать поток при выборе камеры"
                          Foreground="{StaticResource TextPrimary}"
                          Margin="0,4,0,16"/>

                <TextBlock Text="Папка записи видео"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11" Margin="0,0,0,6"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="RecordingsPathBox"
                             FontFamily="{StaticResource MonoFont}"/>
                    <Button Grid.Column="1" Content="Обзор…"
                            Click="Browse_Click"
                            Padding="14,6" Margin="6,0,0,0"/>
                </Grid>

                <TextBlock x:Name="DefaultHint"
                           FontSize="11" FontFamily="{StaticResource MonoFont}"
                           Foreground="{StaticResource TextDim}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="3" Background="{StaticResource BgPanelHeader}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="Отмена"
                            Click="Cancel_Click" IsCancel="True"
                            Padding="16,7" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Сохранить"
                            Style="{StaticResource AccentButton}"
                            Padding="16,7" IsDefault="True"
                            Click="Save_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
