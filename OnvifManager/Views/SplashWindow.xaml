<Window x:Class="OnvifManager.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:OnvifManager.Resources"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Width="800" Height="500"
        Topmost="True"
        Focusable="False">

    <Canvas>
        <Image Source="/Assets/splash.png" Width="800" Height="500"
               Stretch="Fill" Canvas.Left="0" Canvas.Top="0"/>

        <TextBlock Canvas.Left="66" Canvas.Top="458"
                   Text="{x:Static r:Strings.SplashTagline}"
                   FontFamily="Segoe UI"
                   FontSize="18"
                   FontWeight="Normal"
                   Foreground="#B8FFFFFF"/>
    </Canvas>
</Window>
