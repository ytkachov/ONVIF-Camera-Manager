<UserControl x:Class="OnvifManager.Views.VendorSections"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OnvifManager.Views"
             mc:Ignorable="d"
             d:DesignHeight="260" d:DesignWidth="340">

    <UserControl.Resources>
        <Style x:Key="VendorRowLabel" TargetType="TextBlock" BasedOn="{StaticResource FormLabel}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <DataTemplate x:Key="VendorBoolTemplate">
            <Grid Margin="0,0,0,8" Background="Transparent"
                  ToolTip="{Binding Tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource VendorRowLabel}"
                           TextTrimming="CharacterEllipsis"/>
                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                          IsChecked="{Binding BoolValue, Mode=TwoWay}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="VendorIntTemplate">
            <Grid Margin="0,0,0,8" Background="Transparent"
                  ToolTip="{Binding Tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource VendorRowLabel}"
                           TextTrimming="CharacterEllipsis"/>
                <Slider Grid.Column="1" VerticalAlignment="Center"
                        Minimum="{Binding Min}" Maximum="{Binding Max}"
                        SmallChange="{Binding Step}" LargeChange="{Binding Step}"
                        TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                        Value="{Binding IntValue, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" Text="{Binding IntValue}"
                           Foreground="{StaticResource TextSecondary}"
                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="VendorEnumTemplate">
            <Grid Margin="0,0,0,8" Background="Transparent"
                  ToolTip="{Binding Tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource VendorRowLabel}"
                           TextTrimming="CharacterEllipsis"/>
                <ComboBox Grid.Column="1" VerticalAlignment="Center"
                          ItemsSource="{Binding Options}"
                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                          DisplayMemberPath="Label"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="VendorStringTemplate">
            <Grid Margin="0,0,0,8" Background="Transparent"
                  ToolTip="{Binding Tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource VendorRowLabel}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBox Grid.Column="1" VerticalAlignment="Center"
                         Text="{Binding StringValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </DataTemplate>

        <local:VendorParamTemplateSelector x:Key="VendorParamSelector"
                                           BoolTemplate="{StaticResource VendorBoolTemplate}"
                                           IntTemplate="{StaticResource VendorIntTemplate}"
                                           EnumTemplate="{StaticResource VendorEnumTemplate}"
                                           StringTemplate="{StaticResource VendorStringTemplate}"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280" Padding="14,10,14,4">
        <ItemsControl x:Name="SectionsHost">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                                Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Parameters}"
                                      ItemTemplateSelector="{StaticResource VendorParamSelector}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
