<UserControl x:Class="OnvifManager.Views.VideoConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:OnvifManager.Views"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="340">

    <UserControl.Resources>
        <Style x:Key="ParamLabel" TargetType="TextBlock" BasedOn="{StaticResource FormLabel}">
            <Setter Property="Width" Value="115"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
        <StackPanel>

            <!-- Profile -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="ПРОФИЛЬ" Style="{StaticResource SectionTitle}"/>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Профиль" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}"
                              DisplayMemberPath="Name"
                              ToolTip="Медиа-профиль ONVIF — именованный набор настроек потока (видео/аудио/метаданные). Камеры обычно отдают main и sub поток."/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Энкодер" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding EncoderConfigs}"
                              SelectedItem="{Binding SelectedEncoder}"
                              DisplayMemberPath="Name"
                              ToolTip="Конфигурация видеокодера (разрешение, битрейт, кодек), привязанная к профилю."/>
                </Grid>
            </StackPanel>

            <!-- Encoding -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="КОДИРОВАНИЕ" Style="{StaticResource SectionTitle}"/>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Кодек" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding Encoding}" IsReadOnly="True"
                             ToolTip="Алгоритм сжатия видео (только чтение). H.265 (HEVC) даёт ту же картинку при меньшем битрейте, чем H.264. Реальный кодек берётся из ONVIF Media2."/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="H.264 Profile" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Column="1" Text="{Binding H264Profile}" IsEditable="True"
                              ToolTip="Профиль кодирования H.264: Baseline (макс. совместимость) → Main → High (лучшее сжатие, выше нагрузка).">

                        <ComboBoxItem Content="Baseline"/>
                        <ComboBoxItem Content="Main"/>
                        <ComboBoxItem Content="High"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="GOV Length" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding GovLength}"
                             ToolTip="Длина GOP — интервал между ключевыми (I) кадрами. Больше = меньше битрейт, но дольше восстановление картинки при потерях."/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Битрейт, kbps" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding BitrateLimit}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Тип битрейта" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding Quality}"
                              ToolTip="CBR — постоянный битрейт (предсказуемый трафик); VBR — переменный (экономит на статичной сцене); CQ — постоянное качество.">

                        <ComboBoxItem Content="CBR (постоянный)"/>
                        <ComboBoxItem Content="VBR (переменный)"/>
                        <ComboBoxItem Content="CQ (постоянное качество)"/>
                    </ComboBox>
                </Grid>
            </StackPanel>

            <!-- Resolution & rate -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="РАЗРЕШЕНИЕ" Style="{StaticResource SectionTitle}"/>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="W × H" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding Width}"/>
                    <TextBox Grid.Column="3" Text="{Binding Height}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Частота, fps" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding FrameRateLimit}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Enc. interval" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding EncodingInterval}"
                             ToolTip="Encoding interval — кодируется каждый N-й кадр (1 = все кадры, 2 = каждый второй и т.д.). Снижает FPS потока."/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Stream URI" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding StreamUri}" IsReadOnly="True"
                             TextWrapping="NoWrap"/>
                </Grid>
            </StackPanel>

            <!-- Vendor-specific parameters (config-driven) — shown only in Full mode,
                 scrolls together with the standard parameters above. -->
            <views:VendorSections TabKey="Video"
                DataContext="{Binding DataContext.VendorHost, RelativeSource={RelativeSource AncestorType=Window}}"
                Visibility="{Binding DataContext.IsFullMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource Muted}" FontSize="11"
                       Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
