<UserControl x:Class="OnvifManager.Views.VideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="600">

    <Grid ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF1A2030" Offset="0"/>
                <GradientStop Color="#FF0A0C10" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- No-signal placeholder centered -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding Discovery.SelectedCamera, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <TextBlock Text="NO SIGNAL" FontSize="32" FontWeight="Bold"
                       Foreground="#22FFFFFF" HorizontalAlignment="Center"/>
            <TextBlock Text="Выберите камеру слева" FontSize="12"
                       Foreground="{StaticResource TextDim}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- OSD overlays (shown only when camera selected) -->
        <Grid Visibility="{Binding Discovery.SelectedCamera, Converter={StaticResource BoolToVis}}">

            <!-- Top-left: LIVE badge + camera name + IP -->
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top"
                        Orientation="Horizontal" Margin="14,12">
                <Border Style="{StaticResource LiveBadge}">
                    <TextBlock Text="LIVE" Foreground="White"
                               FontSize="10" FontWeight="Bold"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="13">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="4"
                                              ShadowDepth="1" Opacity="0.9"/>
                        </TextBlock.Effect>
                        <Run Text="{Binding Discovery.SelectedCamera.Name, FallbackValue=''}"/>
                    </TextBlock>
                    <TextBlock Foreground="#CCFFFFFF" FontSize="11"
                               FontFamily="{StaticResource MonoFont}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="3"
                                              ShadowDepth="1" Opacity="0.8"/>
                        </TextBlock.Effect>
                        <Run Text="{Binding Discovery.SelectedCamera.IpAddress, FallbackValue=''}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- Top-right: video controls (overlay) -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                        Orientation="Horizontal" Margin="14,12">
                <Button Style="{StaticResource VideoControlButton}" ToolTip="Пауза"
                        Command="{Binding StopStreamCommand}">
                    <Path Width="12" Height="12" Fill="{StaticResource TextPrimary}"
                          Data="{StaticResource IconPause}" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource VideoControlButton}" ToolTip="Снимок"
                        Command="{Binding SnapshotCommand}">
                    <Path Width="12" Height="12" Fill="{StaticResource TextPrimary}"
                          Data="{StaticResource IconSnapshot}" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource VideoControlButton}" ToolTip="Запись"
                        Command="{Binding ToggleRecordCommand}">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource Danger}"/>
                </Button>
                <Button Style="{StaticResource VideoControlButton}" ToolTip="На весь экран">
                    <Path Width="12" Height="12" Fill="{StaticResource TextPrimary}"
                          Data="{StaticResource IconFullscreen}" Stretch="Uniform"/>
                </Button>
            </StackPanel>

            <!-- Bottom telemetry strip overlaid on video -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Background="#80000000" Padding="14,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Foreground" Value="#CCFFFFFF"/>
                            <Setter Property="Margin" Value="0,0,18,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </Grid.Resources>

                    <TextBlock Grid.Column="0">
                        <Run Text="FPS" Foreground="#80FFFFFF"/>
                        <Run Text=" —"/>
                    </TextBlock>
                    <TextBlock Grid.Column="1">
                        <Run Text="Битрейт" Foreground="#80FFFFFF"/>
                        <Run Text=" —"/>
                    </TextBlock>
                    <TextBlock Grid.Column="2">
                        <Run Text="Разрешение" Foreground="#80FFFFFF"/>
                        <Run Text=" "/>
                        <Run Text="{Binding VideoConfig.Width, FallbackValue='—', Mode=OneWay}"/>
                        <Run Text="×"/>
                        <Run Text="{Binding VideoConfig.Height, FallbackValue='—', Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Grid.Column="3">
                        <Run Text="Кодек" Foreground="#80FFFFFF"/>
                        <Run Text=" "/>
                        <Run Text="{Binding VideoConfig.Encoding, FallbackValue='—', Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Grid.Column="4">
                        <Run Text="Задержка" Foreground="#80FFFFFF"/>
                        <Run Text=" —"/>
                    </TextBlock>
                    <TextBlock Grid.Column="5" HorizontalAlignment="Right" Margin="0"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="RTSP" Foreground="#80FFFFFF"/>
                        <Run Text=" "/>
                        <Run Text="{Binding VideoConfig.StreamUri, FallbackValue='—'}"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
