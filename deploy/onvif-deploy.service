[Unit]
Description=ONVIF Web auto-deploy (pull + rebuild if origin/master moved)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=ytkachov
SupplementaryGroups=docker
Environment=HOME=/home/ytkachov
ExecStart=/home/ytkachov/onvif-web/deploy/auto-deploy.sh
# Avoid overlap if a previous tick is still rebuilding.
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target
