[Unit]
Description=Tick auto-deploy every minute

[Timer]
# First tick 30s after timer starts.
OnActiveSec=30s
# Re-arm 1 min after the previous run finished (not started) — prevents
# overlapping rebuilds if a build runs longer than the interval.
OnUnitInactiveSec=1min
Unit=onvif-deploy.service
AccuracySec=10s

[Install]
WantedBy=timers.target
